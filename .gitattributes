* text=auto
*.dart text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.sh text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.webp binary
*.wav binary
